{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about-us", "destination": "/aboutus.html" },
    { "source": "/aboutus", "destination": "/aboutus.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/tracking", "destination": "/tracking.html" },
    { "source": "/create-shipment", "destination": "/create-shipment.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/services/domestic", "destination": "/service-domestic-worldwide-deliveries.html" },
    { "source": "/services/warehousing", "destination": "/service-warehousing.html" },
    { "source": "/services/international", "destination": "/service-international-crossborder.html" },
    { "source": "/services/freight", "destination": "/service-worldwideforwarding.html" },
    { "source": "/international-shipping", "destination": "/international-shipping.html" },
    { "source": "/logistics-partner", "destination": "/logistics-partner-singapore.html" },
    { "source": "/media", "destination": "/media-listing.html" },
    { "source": "/privacy-policy", "destination": "/privacypolicy.html" },
    { "source": "/terms-of-service", "destination": "/termsofservice.html" },
    { "source": "/standard-conditions", "destination": "/standardconditionsofcarriage.html" },
    { "source": "/fuel-surcharge", "destination": "/fuelsurcharge.html" },
    { "source": "/worldwide-domestic", "destination": "/worldwide-domestic-courier-service.html" },
    { "source": "/coming-soon", "destination": "/comingsoon.html" },
    { "source": "/enterprise-tools", "destination": "/enterprise-tools.html" },
    { "source": "/api/:path*", "destination": "https://shipnow.airpak-express.site/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
